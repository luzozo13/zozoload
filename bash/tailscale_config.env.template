# 🔧 Tailscale Configuration Template
# 📝 Configuration file template for Tailscale installation script
# ⚠️ Copy this file to 'tailscale_config.env' and customize the values

# 📦 Container name
CONTAINER_NAME="tailscale"

# 🐋 Docker/Podman image to use
TAILSCALE_IMAGE="tailscale/tailscale"

# 🏠 Local subnet where Home Assistant is located
# Example: 192.168.1.0/24, 10.0.0.0/24, 172.16.0.0/24
SUBNET="YOUR_LOCAL_SUBNET/24"

# 🔑 Tailscale authentication key
# ⚠️ Generate at https://login.tailscale.com/admin/settings/authkeys
# Replace with your actual key: tskey-auth-xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTHKEY="YOUR_TAILSCALE_AUTH_KEY"

# 📁 Persistent configuration directory
CONFIG_DIR="/etc/tailscale"
